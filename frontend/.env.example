# Backend API base URL. Leave unset for local dev — the Vite proxy in
# vite.config.js forwards /api to localhost:5000. Set this on any deployed
# environment, e.g. https://maison-luxe-api-kxu5.onrender.com/api
VITE_API_URL=

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
